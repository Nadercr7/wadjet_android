rules_version = '2';

// Wadjet — Firestore security rules (A2 / J-02)
//
// Deploy from the repo root with the Firebase CLI:
//   firebase deploy --only firestore:rules
// (see docs/audit/FIREBASE_RUNBOOK.md)
//
// Least privilege: a signed-in user can read/write ONLY their own subtree.
// users/{uid}/story_progress/{storyId} — story progress mirror
// users/{uid}/fcm_tokens/{token}       — device push tokens (A3)
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
